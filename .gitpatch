diff -ruN '--exclude=build' '--exclude=.git' calcirok-orig/include/platform.h calcirok-new/include/platform.h
--- a/include/platform.h	2026-10-11 19:06:45.663729521 +0000
+++ b/include/platform.h	2026-10-11 19:11:02.778783925 +0000
@@ -2,17 +2,17 @@
 
 // ---------------------------------------------------------------------------
 // platform.h — Bare-metal I/O abstraction for calcirok
-//
-// Replace the bodies of these functions with GNOD / Nova console primitives.
-// Nothing in this project includes <iostream>, <cstdio>, or any libc header.
 // ---------------------------------------------------------------------------
 
-// Write a single character to the console output.
-void plat_putc(char c);
+#ifdef __cplusplus
+extern "C" {
+#endif
 
-// Read a single character from the console (blocking).
+void plat_init();
+void plat_putc(char c);
 char plat_getc();
+unsigned char plat_lsr();
 
-// Initialize the platform (COM1 serial, 115200 8N1).
-// Called once from _start before calcirok_main().
-void plat_init();
+#ifdef __cplusplus
+}
+#endif
diff -ruN '--exclude=build' '--exclude=.git' calcirok-orig/src/boot.cpp calcirok-new/src/boot.cpp
--- a/src/boot.cpp	2026-10-11 19:06:45.663729521 +0000
+++ b/src/boot.cpp	2026-10-11 19:11:02.776873743 +0000
@@ -1,15 +1,10 @@
 // ---------------------------------------------------------------------------
-// boot.cpp — Multiboot1 header + bare-metal entry point
-//
-// QEMU -kernel supports Multiboot1 (not Multiboot2) with 64-bit ELF.
-// The header must appear in the first 8KB of the image, 4-byte aligned.
+// boot.cpp — Multiboot1 header + explicit stack + entry point
 // ---------------------------------------------------------------------------
-#include "platform.h"
-
-// ---- Multiboot1 header ----------------------------------------------------
 
+// Multiboot1 header
 #define MB1_MAGIC    0x1BADB002
-#define MB1_FLAGS    0x00000000   // no modules, no memory map needed
+#define MB1_FLAGS    0x00000000
 #define MB1_CHECKSUM (-(MB1_MAGIC + MB1_FLAGS))
 
 __attribute__((section(".multiboot"), used))
@@ -19,11 +14,24 @@
     static_cast<unsigned int>(MB1_CHECKSUM),
 };
 
-// ---- entry point ----------------------------------------------------------
-
-extern "C" [[noreturn]] void calcirok_main();
+// 16KB stack in .bss, referenced by name from asm
+extern "C" {
+    unsigned char calcirok_stack[16384] __attribute__((aligned(16)));
+    void plat_init();
+    [[noreturn]] void calcirok_main();
+}
 
-extern "C" [[noreturn]] void _start() {
-    plat_init();
-    calcirok_main();
+// _start: naked so the compiler emits no prologue that would use the
+// (possibly invalid) stack Multiboot1 left us with.
+extern "C" __attribute__((naked, section(".text._start"))) void _start() {
+    asm volatile(
+        // Load address of top of our own stack into ESP before anything else
+        "movl $(calcirok_stack + 16384), %%esp\n\t"
+        "call plat_init\n\t"
+        "call calcirok_main\n\t"
+        // calcirok_main never returns, but halt just in case
+        "0: hlt\n\t"
+        "jmp 0b\n\t"
+        ::: "memory"
+    );
 }
diff -ruN '--exclude=build' '--exclude=.git' calcirok-orig/src/io.cpp calcirok-new/src/io.cpp
--- a/src/io.cpp	2026-10-11 19:06:45.663815486 +0000
+++ b/src/io.cpp	2026-10-11 19:06:51.347506832 +0000
@@ -42,20 +42,35 @@
     int count = 0;
     while (count < buf_len - 1) {
         char c = plat_getc();
-        if (c == '\r' || c == '\n') {
-            putnl();        // echo newline back
+        if (c == '\r') {
+            putnl();
+            // consume a trailing \n if it follows immediately
+            // peek: only consume if data is ready right now
+            // we do a non-blocking check via LSR bit 0
+            // (inb(0x3F8+5) & 0x01) — if set, read and discard if \n
+            // We expose this via a small helper inline here.
+
+            if (plat_lsr() & 0x01) {
+                char next = plat_getc();
+                if (next != '\n') {
+                    // not a \n — put it into the buffer
+                    buf[count++] = next;
+                }
+            }
+            break;
+        }
+        if (c == '\n') {
+            putnl();
             break;
         }
-        if (c == 127 || c == '\b') {   // backspace
+        if (c == 127 || c == '\b') {
             if (count > 0) {
                 count--;
-                plat_putc('\b');
-                plat_putc(' ');
-                plat_putc('\b');
+                plat_putc('\b'); plat_putc(' '); plat_putc('\b');
             }
             continue;
         }
-        plat_putc(c);       // echo character back
+        plat_putc(c);
         buf[count++] = c;
     }
     buf[count] = '\0';
diff -ruN '--exclude=build' '--exclude=.git' calcirok-orig/src/main.cpp calcirok-new/src/main.cpp
--- a/src/main.cpp	2026-10-11 19:06:45.663815486 +0000
+++ b/src/main.cpp	2026-10-11 19:06:51.347539367 +0000
@@ -1,14 +1,10 @@
 // ---------------------------------------------------------------------------
-// main.cpp — calcirok freestanding entry point
-//
-// On bare metal this is the kernel entry (_start or equivalent).
-// When built with -DCALCIROK_HOSTED it behaves as a normal main().
+// main.cpp — calcirok bare-metal entry point
 // ---------------------------------------------------------------------------
 #include "io.h"
 #include "input.h"
 #include "util.h"
 
-// Input buffer size: enough for "999999999.9 / 999999999.9\0"
 static constexpr int BUF_LEN = 64;
 
 static double dispatch(double a, double b, char op) {
@@ -21,10 +17,6 @@
     }
 }
 
-// ---------------------------------------------------------------------------
-// Bare-metal kernel entry — no argc/argv, no OS runtime.
-// Rename / adjust for your specific boot environment.
-// ---------------------------------------------------------------------------
 extern "C" [[noreturn]] void calcirok_main() {
     puts_raw("#----------------------#"); putnl();
     puts_raw("| WELCOME TO CALCIROK! |"); putnl();
@@ -38,7 +30,7 @@
         puts_raw(": ");
         int len = getline_raw(buf, BUF_LEN);
 
-        if (len == 0) continue;
+        if (len == 0) continue;  // skip empty / stray CR
 
         ParseResult r = parse_expr(buf, len);
         if (!r.ok) {
@@ -47,25 +39,13 @@
             continue;
         }
 
-        // Special-case divide-by-zero reporting
-        if ((r.op == '/') && (r.b == 0.0)) {
+        if (r.op == '/' && r.b == 0.0) {
             puts_raw("error: division by zero");
             putnl();
             continue;
         }
 
-        double result = dispatch(r.a, r.b, r.op);
-        putd(result, 6);
+        putd(dispatch(r.a, r.b, r.op), 6);
         putnl();
     }
 }
-
-// ---------------------------------------------------------------------------
-// Hosted shim: lets you build and run on Linux/macOS for dev/testing.
-// CMake sets CALCIROK_HOSTED for the hosted target only.
-// ---------------------------------------------------------------------------
-#ifdef CALCIROK_HOSTED
-int main() {
-    calcirok_main();
-}
-#endif
diff -ruN '--exclude=build' '--exclude=.git' calcirok-orig/src/platform.cpp calcirok-new/src/platform.cpp
--- a/src/platform.cpp	2026-10-11 19:06:45.663815486 +0000
+++ b/src/platform.cpp	2026-10-11 19:06:51.347478752 +0000
@@ -38,3 +38,7 @@
         asm volatile("pause");
     return static_cast<char>(inb(COM1));
 }
+
+unsigned char plat_lsr() {
+    return inb(COM1 + 5);
+}
